# Copy to .env and fill in, or run `python scripts/init_env.py` to generate secrets.

# Long random string (>= 32 chars), e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

POSTGRES_USER=news
POSTGRES_PASSWORD=
POSTGRES_DB=news

# Host ports for local access (changed from defaults to avoid clashing with local installs)
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Used when running the app outside Docker (docker-compose overrides these two)
DATABASE_URL=postgresql+asyncpg://news:<POSTGRES_PASSWORD>@localhost:5433/news
REDIS_URL=redis://localhost:6380/0

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_SESSIONS_PER_USER=5
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
NEWS_CACHE_TTL_SECONDS=300

# GitHub OAuth app (https://github.com/settings/developers). Leave empty to disable.
# Callback URL: <PUBLIC_BASE_URL>/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
